{
  "name": "sticky",
  "productName": "Sticky",
  "version": "1.0.1",
  "description": "윈도우·맥·아이폰에서 쓰는 스티커 메모",
  "author": "limmmmmmn",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:desktop": "node scripts/build.mjs desktop",
    "build:site": "node scripts/build.mjs site",
    "icons": "node scripts/icons.mjs",
    "start": "node scripts/build.mjs desktop && electron .",
    "dist:win": "node scripts/build.mjs desktop && electron-builder --win --publish never",
    "dist:mac": "node scripts/build.mjs desktop && electron-builder --mac --publish never",
    "test": "node --test test/sync-engine.test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "pretendard": "^1.3.9",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "io.github.limmmmmmn.sticky",
    "productName": "Sticky",
    "copyright": "© 2026 limmmmmmn",
    "directories": {
      "output": "release",
      "buildResources": "assets/build"
    },
    "files": [
      "electron/**",
      "out/desktop/**",
      "assets/tray/**",
      "assets/build/icon-win.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/build/icon-win.png",
      "artifactName": "Sticky-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sticky",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/build/icon-mac.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Sticky-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Sticky ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "limmmmmmn",
        "repo": "Sticky",
        "releaseType": "release"
      }
    ]
  }
}
